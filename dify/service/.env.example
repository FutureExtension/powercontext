# =====================================================================
#  雾隐镇 · 夜班档案室 —— 工具服务配置示例
#  复制成 .env 后按实际环境修改（.env 不要提交到仓库）
# =====================================================================

# ---- seekdb 连接（MySQL 协议） ----------------------------------------
SEEKDB_HOST=127.0.0.1
SEEKDB_PORT=2881
SEEKDB_USER=root
SEEKDB_PASSWORD=replace-with-your-seekdb-password
SEEKDB_DATABASE=wuyin_archive
SEEKDB_CHARSET=utf8mb4
SEEKDB_CONNECT_TIMEOUT=10
SEEKDB_READ_TIMEOUT=30
SEEKDB_WRITE_TIMEOUT=30

# ---- 工具服务监听地址 --------------------------------------------------
# Dify 在 Docker 里访问宿主机时用 http://host.docker.internal:8100
# Dify 直接跑在本机时用 http://127.0.0.1:8100
TOOL_HOST=0.0.0.0
TOOL_PORT=8100
TOOL_LOG_LEVEL=info

# ---- 可选：自定义工具的接口鉴权 ----------------------------------------
# 留空表示不鉴权；填了值后，Dify 自定义工具的 credentials 里
# 需要配置同名请求头 X-Api-Key
TOOL_API_KEY=

# ---- 全文索引模式 ------------------------------------------------------
# auto（默认）：缺索引就创建，失败自动退回 LIKE 检索
# on          ：只用全文索引
# off         ：完全不创建全文索引，检索走 LIKE
# seekdb 1.3.0 在 Windows 上执行 ADD FULLTEXT KEY 可能让服务端崩溃，
# 那种环境请设为 off。
DIFY_FULLTEXT=auto
